# Database
DATABASE_URL=postgresql+asyncpg://cropguard:cropguard123@localhost:5432/cropguard

# Redis
REDIS_URL=redis://localhost:6379/0

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-this
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Weather API (optional - mock data used if not provided)
WEATHER_API_KEY=

# Storage (local for dev, s3/r2/minio for production)
STORAGE_TYPE=local
STORAGE_PATH=./uploads
STORAGE_ENDPOINT=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_BUCKET=

# Demo mode
DEMO_MODE=true

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_DEMO_MODE=true
